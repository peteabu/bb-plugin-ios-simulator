{
  "name": "bb-plugin-ios-simulator",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.37",
    "node": ">=20"
  },
  "bb": {
    "name": "iOS Simulator",
    "description": "Run iOS simulators and Android emulators beside your BB thread, with shared controls and tools for agents to launch and test apps.",
    "branding": {
      "icon": "Smartphone",
      "experimental_icons": {
        "camera": "./icons/camera.svg",
        "home": "./icons/home.svg",
        "lock": "./icons/lock.svg",
        "play": "./icons/play.svg",
        "plug": "./icons/plug.svg",
        "power": "./icons/power.svg",
        "rotate": "./icons/rotate.svg",
        "shield-check": "./icons/shield-check.svg",
        "shield-off": "./icons/shield-off.svg",
        "spinner": "./icons/spinner.svg",
        "unplug": "./icons/unplug.svg",
        "volume-down": "./icons/volume-down.svg",
        "volume-up": "./icons/volume-up.svg",
        "wrench": "./icons/wrench.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.6.5",
    "serve-sim": "0.1.48",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.37",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "typescript": "^5.7.0",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "@types/ws": "^8.18.1",
    "vitest": "^3.2.4",
    "jsdom": "^26.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/dom": "^10.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "description": "Run and control iOS simulators and Android emulators beside a BB thread.",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "bb plugin build",
    "build:native": "./scripts/build-native.sh",
    "build:pasteboard": "./scripts/build-pasteboard.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/peteabu/bb-plugin-ios-simulator.git"
  },
  "author": {
    "name": "Peter Abu",
    "url": "https://github.com/peteabu"
  }
}
